{
  "name": "adb-connector",
  "version": "2.6.1",
  "description": "Simple ADB & WebADB connector for Android",
  "main": "src/main.js",
  "scripts": {
    "bundle": "esbuild src/renderer/app.js --bundle --format=iife --target=chrome130 --outfile=src/renderer/bundle.js --minify --loader:.css=css",
    "start": "npm run bundle && electron .",
    "dist": "npm run bundle && electron-builder --win nsis --x64",
    "release": "npm run bundle && electron-builder --win nsis --x64 --publish always"
  },
  "author": "Moshe",
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-credential-web": "^2.1.0",
    "@yume-chan/adb-daemon-webusb": "^2.3.2",
    "@yume-chan/stream-extra": "^2.6.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "resedit": "^3.1.0"
  },
  "productName": "ADB Connector",
  "build": {
    "appId": "com.moshe.adbconnector",
    "productName": "ADB Connector",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.js",
      "src/apkmeta.js",
      "src/preload.js",
      "src/renderer/index.html",
      "src/renderer/styles.css",
      "src/renderer/bundle.js",
      "src/renderer/bundle.css",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/platform",
        "to": "platform"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "./build/afterPack.js",
    "asar": true,
    "compression": "maximum",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ADB Connector",
      "artifactName": "ADB-Connector-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "angreenade",
        "repo": "adb-connector",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/angreenade/adb-connector.git"
  },
  "homepage": "https://github.com/angreenade/adb-connector"
}
